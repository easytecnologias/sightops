# SightOps v3 -- variaveis de ambiente.
# Copie para .env e preencha. NUNCA versione o .env preenchido.
#
#   cp .env.example .env && nano .env
#
# Gerar os segredos (um valor novo por instalacao):
#   openssl rand -hex 32

# ---------------------------------------------------------------- obrigatorio
# Cifra as senhas de OLT e equipamentos guardadas no banco.
# TROCAR OU PERDER ESTE VALOR TORNA ILEGIVEL TUDO QUE JA FOI CIFRADO.
# Guarde junto do backup do banco -- um nao serve sem o outro.
SIGHTOPS_SECRET_KEY=

SIGHTOPS_DB=sightops
SIGHTOPS_DB_USER=sightops
SIGHTOPS_DB_PASSWORD=

# Imagem da API. Em producao usamos tag local versionada (ver docs/DEPLOY.md).
CAM_SNAPSHOT_IMAGE=sightops-prod-api:latest

# ------------------------------------------------------------------- rede/API
SIGHTOPS_HTTP_PORT=8087
SIGHTOPS_PUBLIC_HTTP_PORT=8087
SIGHTOPS_POSTGRES_PORT=5433
TZ=America/Maceio

# Dominios que podem chamar a API pelo navegador (separados por virgula).
ALLOWED_ORIGINS=
# IPs/redes de proxy reverso confiaveis, para ler o IP real do cliente.
TRUSTED_PROXIES=

# --------------------------------------------------------------- autenticacao
# AUTH_REQUIRED=true exige login em toda rota /api/ que nao seja publica.
# AUTH_LEGACY_OPEN=false mantem o comportamento seguro; true so existe para
# compatibilidade com instalacao antiga e NAO deve ser usado em producao.
AUTH_REQUIRED=true
AUTH_LEGACY_OPEN=false

# /docs e /redoc. Deixe false em producao: expoe o mapa inteiro da API.
ENABLE_DOCS=false
ENABLE_LEGACY_STATE_IMPORT=false

# ---------------------------------------------------------------- integracoes
# Opcionais: sem eles o recurso correspondente fica desligado.
IMGBB_API_KEY=
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-2.0-flash
SIGHTOPS_ACCESS_CONTROL_SYNC_INTERVAL=300

# --------------------------------------------------------- Zabbix (monitor)
ZABBIX_DB=zabbix
ZABBIX_DB_USER=zabbix
ZABBIX_DB_PASSWORD=
ZABBIX_SERVER_IMAGE=zabbix/zabbix-server-pgsql:alpine-7.0-latest
ZABBIX_WEB_IMAGE=zabbix/zabbix-web-nginx-pgsql:alpine-7.0-latest
ZABBIX_AGENT_IMAGE=zabbix/zabbix-agent:alpine-7.0-latest
ZABBIX_AGENT_HOSTNAME=sightops-v3
ZABBIX_SERVER_PORT=10053
ZABBIX_WEB_PORT=8091
ZBX_CACHESIZE=64M
ZBX_HISTORYCACHESIZE=32M
ZBX_TRENDCACHESIZE=32M
ZBX_VALUECACHESIZE=32M

# --------------------------------------------------------------- Grafana
GRAFANA_IMAGE=grafana/grafana:11.1.0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3003
GRAFANA_INSTALL_PLUGINS=
