# Este repositorio e implantado em Linux. Sem isto, o Git no Windows grava
# CRLF e um script .sh commitado daqui falha no servidor com
# "bad interpreter: /bin/bash^M" -- erro que nao aparece em teste local.
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.sql  text eol=lf
Dockerfile text eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.exe  binary
